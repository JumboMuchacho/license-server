import hmac
import hashlib
import json
import os

from fastapi import APIRouter, Request, HTTPException, Depends
from sqlalchemy.orm import Session

from database import get_db
from models import UpdateManifest

router = APIRouter(tags=["Updates"])

LICENSE_SECRET = os.getenv("LICENSE_SECRET")
if not LICENSE_SECRET:
    raise RuntimeError("LICENSE_SECRET not configured")

LICENSE_SECRET = LICENSE_SECRET.encode()


def verify_sig(payload: dict, sig: str) -> bool:
    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    expected = hmac.new(LICENSE_SECRET, raw, hashlib.sha256).hexdigest()
    return hmac.compare_digest(expected, sig)


@router.post("/update-manifest")
async def update_manifest(req: Request, db: Session = Depends(get_db)):
    body = await req.json()
    sig = req.headers.get("X-Signature")

    if not sig or not verify_sig(body, sig):
        raise HTTPException(status_code=403, detail="Invalid signature")

    manifest = (
        db.query(UpdateManifest)
        .order_by(UpdateManifest.updated_at.desc())
        .first()
    )

    if not manifest:
        raise HTTPException(status_code=404, detail="No update manifest configured")

    return {
        "latest_version": manifest.latest_version,
        "min_required_version": manifest.min_required_version,
        "mandatory": manifest.mandatory,
        "url": manifest.url,
        "sha256": manifest.sha256,
    }
